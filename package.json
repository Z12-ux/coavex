{
  "name": "coach-os",
  "version": "0.1.0",
  "private": true,
  "description": "COAVEX — Fitness Coaching Operating System (coach command center, client signal engine, next-best-action, adaptive programs, check-ins, weekly review).",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "node scripts/build.mjs",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/reset-db.mjs && prisma db push && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/build.mjs --generate-only",
    "db:seed:snapshot": "node scripts/reset-db.mjs && prisma db push && tsx prisma/seed.ts && node -e \"require('fs').copyFileSync('prisma/dev.db','prisma/seed.db')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.26",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
