# ── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite, zero setup.
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL (Supabase / Neon / Vercel Postgres). When DATABASE_URL
# starts with postgres://, scripts/build.mjs generates the client from
# prisma/schema.postgres.prisma. Use the pooled URL here and the direct URL below.
# DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&schema=coachos"
# DIRECT_URL="postgresql://user:pass@host:5432/postgres?schema=coachos"
#
# Demo mode: on a serverless host (VERCEL=1) with no postgres URL, the seeded
# SQLite file prisma/seed.db is copied to the instance temp dir on first use.
# Data then persists only for the life of that instance. Set COACHOS_DEMO_DB=1
# to force this behaviour locally.

# ── App ─────────────────────────────────────────────────────────────────────
# Signs the cookie in demo mode (stateless sessions across serverless instances). Set a random value in production.
SESSION_SECRET="change-me-in-production"
APP_URL="http://localhost:3210"

# ── AI copilots (optional) ──────────────────────────────────────────────────
# Without a key COAVEX uses the rule-based composer and says so in the UI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Only for organization-level keys (not scoped to a workspace): the API then
# requires the workspace id on every request (console.anthropic.com → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=""
